@page "/login"
@using MudBlazor
@layout AuthLayout
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Login - EduSystem</PageTitle>



<div class="auth-page">
    <div class="glass-card">
        <!-- Brand/Info Section -->
        <div class="brand-panel">
            <div class="brand-content">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Style="font-size: 3.5rem; margin-bottom: 1.5rem;" />
                
                <MudText Typo="Typo.h4" Style="font-weight: 800; margin-bottom: 0.5rem; letter-spacing: -0.5px;">
                    EduSystem
                </MudText>
                
                <MudText Typo="Typo.body1" Style="opacity: 0.9; margin-bottom: 2.5rem;">
                    Welcome back! Please login to your account.
                </MudText>

                <MudStack Spacing="3" Class="d-none d-md-flex">
                   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Secure Authentication</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Fast Access</MudText>
                    </MudStack>
                </MudStack>
            </div>
        </div>

        <!-- Login Form Section -->
        <div class="form-panel">
            <div class="form-header">
                <MudText Typo="Typo.h5" Style="font-weight: 700; color: #2d3748;">Member Login</MudText>
                <MudText Typo="Typo.caption" Style="color: #718096;">Access your education management dashboard</MudText>
            </div>

            <MudStack Spacing="2">
                
                <MudTextField @bind-Value="_loginModel.Email"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Required="true"
                              FullWidth="true" />

                <MudTextField @bind-Value="_loginModel.Password"
                              Label="Password"
                              InputType="@_passwordInputType"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              OnAdornmentClick="TogglePasswordVisibility"
                              Required="true"
                              FullWidth="true" />

                <div class="d-flex justify-space-between align-center mt-1">
                     <MudCheckBox @bind-Value="@_rememberMe" Label="Remember me" Color="Color.Primary" Size="Size.Small" Dense="true"></MudCheckBox>
                     <MudLink Href="/forgot-password" Underline="Underline.Hover" Style="font-size: 0.875rem; color: #667eea;">Forgot Password?</MudLink>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-4 py-2"
                           Style="border-radius: 8px; font-weight: 600; text-transform: none;"
                           OnClick="HandleLogin"
                           Disabled="_isLoading">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>Signing In...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </MudButton>

                <MudText Typo="Typo.body2" Align="Align.Center" Style="margin-top: 1.5rem; color: #718096;">
                    Don't have an account? <MudLink Href="/register" Style="font-weight: 600; color: #667eea;">Register Institute</MudLink>
                </MudText>
            </MudStack>
        </div>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private bool _isLoading = false;
    private bool _showPassword = false;
    private bool _rememberMe = false;
    private InputType _passwordInputType = InputType.Password;

    [SupplyParameterFromQuery]
    public string? Tenant { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Tenant))
        {
            // Ideally pre-fill tenant info if applicable, or just used for context
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
        _passwordInputType = _showPassword ? InputType.Text : InputType.Password;
    }

    private async Task HandleLogin()
    {
        _isLoading = true;
        // Simulate login delay for UI testing
        await Task.Delay(1000); 
        
        // TODO: Implement actual login logic here
        
        _isLoading = false;
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
