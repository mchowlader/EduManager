@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@implements IDisposable

<MudNavMenu>
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
        Dashboard
    </MudNavLink>

    <!-- Two-way binding use koro @bind-Expanded -->
    <MudNavGroup Title="Defianation"
                 Icon="@Icons.Material.Filled.MenuBook"
                 @bind-Expanded="isDefinitionExpanded">
        <MudNavLink Href="/teachers" Icon="@Icons.Material.Filled.Class">
            Teachers
        </MudNavLink>
        <MudNavLink Href="/students" Icon="@Icons.Material.Filled.Person">
            Students
        </MudNavLink>
        <MudNavLink Href="/section" Icon="@Icons.Material.Filled.Group">
            Section
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Academy"
                 Icon="@Icons.Material.Filled.Book"
                 @bind-Expanded="isAcademyExpanded">
        <MudNavLink Href="/testmonial" Icon="@Icons.Material.Filled.Newspaper">
            Testmonial
        </MudNavLink>
        <MudNavLink Href="/transcript" Icon="@Icons.Material.Filled.Newspaper">
            Transcript
        </MudNavLink>
        <MudNavLink Href="/admitCard" Icon="@Icons.Material.Filled.Newspaper">
            AdmitCard
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Attendance"
                 Icon="@Icons.Material.Filled.CheckCircle"
                 @bind-Expanded="isAttendanceExpanded">
        <MudNavLink Href="/teachersAttendance" Icon="@Icons.Material.Filled.Class">
            Teachers
        </MudNavLink>
        <MudNavLink Href="/studentsAttendance" Icon="@Icons.Material.Filled.Person">
            Students
        </MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Approve"
        Icon="@Icons.Material.Filled.Approval">
        <MudNavLink Href="/admissionPendingList" Icon="@Icons.Material.Filled.Create">
            Amission
        </MudNavLink>
    </MudNavGroup>


    <MudNavLink Href="/classes" Icon="@Icons.Material.Filled.Class">
        Classes
    </MudNavLink>
    <MudNavLink Href="/exams" Icon="@Icons.Material.Filled.Assignment">
        Exams
    </MudNavLink>
    <MudNavLink Href="/results" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
        Results
    </MudNavLink>

    <MudDivider Class="my-2" />

    <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
        Settings
    </MudNavLink>
</MudNavMenu>

@code {
    private bool isDefinitionExpanded;
    private bool isAcademyExpanded;
    private bool isAttendanceExpanded;

    protected override void OnInitialized()
    {
        UpdateExpandedStates();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateExpandedStates();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateExpandedStates()
    {
        var currentPath = new Uri(NavigationManager.Uri).AbsolutePath.ToLower();

        // More precise path matching
        isDefinitionExpanded = IsPathMatch(currentPath, "/teachers", "/students", "/section");
        isAcademyExpanded = IsPathMatch(currentPath, "/testmonial", "/transcript", "/admitcard");
        isAttendanceExpanded = IsPathMatch(currentPath, "/teachersattendance", "/studentsattendance");
    }

    private bool IsPathMatch(string currentPath, params string[] paths)
    {
        return paths.Any(p => currentPath.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}