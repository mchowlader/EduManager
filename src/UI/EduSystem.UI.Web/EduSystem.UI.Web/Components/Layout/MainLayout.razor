@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="top-bar-glass" Fixed="true">
        <!-- Menu Icon removed as per request -->
        <MudText Typo="Typo.h6" Class="d-none d-md-block ml-4" style="font-weight: 600; color: #4a5568;">Dashboard</MudText>
        <MudSpacer />
        
        <!-- User Profile Section -->
        <div class="user-profile-section">
            <div class="d-flex flex-column align-end mr-2 d-none d-sm-flex">
                <span class="user-name">Admin User</span>
                <span class="user-role">Administrator</span>
            </div>
            <div class="user-avatar">AD</div>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" 
               Elevation="1" 
               Variant="@DrawerVariant.Responsive" 
               ClipMode="DrawerClipMode.Never" 
               Class="mud-drawer-gradient">
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;


}
