@page "/teachers"
@attribute [Authorize]
@using EduSystem.UI.Web.Client.Models
@using EduSystem.UI.Web.Client.Services
@inject ITeacherService teacherservice
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@rendermode InteractiveAuto

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 700;">teachers</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddTeacher">
            Add New Teacher
        </MudButton>
    </div>

    <MudTable Items="@teachers" Dense="true" Hover="true" Bordered="true" Striped="true" Filter="new Func<TeacherModel,bool>(FilterFunc1)" Loading="@loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Student List</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchString" Placeholder="Search by Name" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Desgination</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh Style="text-align:center">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Name">
                <div class="d-flex align-center">
                    <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">@context.Name.Substring(0, 1)</MudAvatar>
                    @context.Name
                </div>
            </MudTd>
      @*       <MudTd DataLabel="Class">
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@context.Class</MudChip>
            </MudTd> *@
            <MudTd DataLabel="Department">@context.Designation</MudTd>
            <MudTd DataLabel="Phone">@context.Phone</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:center">
                <MudTooltip Text="View Details">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small" OnClick="@(() => ViewDetails(context))" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => EditTeacher(context.Id))" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTeacher(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private List<TeacherModel> teachers = new List<TeacherModel>();
    private string searchString = "";
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        teachers = await teacherservice.GetAllTeachersAsync();
        loading = false;
    }

    private void AddTeacher()
    {
        Navigation.NavigateTo("/teachers/add");
    }

    private void EditTeacher(long id)
    {
        Navigation.NavigateTo($"/teachers/edit/{id}");
    }

    private async Task ViewDetails(TeacherModel teacher)
    {
        var parameters = new DialogParameters<TeacherDetailsDialog> { { x => x.Teacher, teacher } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        
        await DialogService.ShowAsync<TeacherDetailsDialog>("Teacher Details", parameters, options);
    }

    private async Task DeleteTeacher(TeacherModel teacher)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Delete Student", 
            $"Are you sure you want to delete {teacher.Name}?", 
            yesText:"Delete", cancelText:"Cancel");

        if (result == true)
        {
            await teacherservice.DeleteTeacherAsync(teacher.Id);
             await LoadData();
             Snackbar.Add("Student deleted", Severity.Success);
        }
    }

    private bool FilterFunc1(TeacherModel teacher) => FilterFunc(teacher, searchString);

    private bool FilterFunc(TeacherModel teacher, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (teacher.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (teacher.Phone?.Contains(searchString) == true)
            return true;
        if ($"{teacher.Id}".Contains(searchString))
             return true;
        return false;
    }
}
