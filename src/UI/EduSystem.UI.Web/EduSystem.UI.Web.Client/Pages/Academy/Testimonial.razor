}

@code {
    [Parameter] public string StudentId { get; set; } = string.Empty;
    private string _searchId = string.Empty;
    private bool _loading = false;
    private TestimonialModel? _testimonial;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(StudentId))
        {
            _searchId = StudentId;
            await LoadTestimonial();
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(_searchId))
        {
            Snackbar.Add("Please enter a valid Student ID", Severity.Error);
            return;
        }

        StudentId = _searchId;
        await LoadTestimonial();
    }

    private async Task LoadTestimonial()
    {
        _loading = true;
        _testimonial = null; // Clear previous result to match Transcript behavior
        try
        {
            _testimonial = await AcademyService.GetTestimonialAsync(StudentId);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error loading testimonial: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task Print()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
