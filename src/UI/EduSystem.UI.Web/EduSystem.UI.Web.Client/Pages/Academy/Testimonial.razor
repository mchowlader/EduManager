                    <div class="field-dot-line" style="width: 480px;">
                        <span class="handwritten-value">@_testimonial.StudentName</span>
                    </div>
                </div>
                <div style="display: flex; align-items: baseline;">
                    <span style="white-space: nowrap;">Son/daughter of </span> 
                    <div class="field-dot-line" style="flex-grow: 1; min-width: 250px;">
                        <span class="handwritten-value">@_testimonial.FatherName</span>
                    </div>
                    <span style="white-space: nowrap; margin: 0 15px;">And </span> 
                    <div class="field-dot-line" style="flex-grow: 1.2; min-width: 250px;">
                        <span class="handwritten-value">@_testimonial.MotherName</span>
                    </div>
                </div>
                <div style="white-space: nowrap;">
                    <span>Village </span> 
                    <div class="field-dot-line" style="width: 160px;">
                        <span class="handwritten-value">@_testimonial.Village</span>
                    </div>
                    <span>P/O.: </span> 
                    <div class="field-dot-line" style="width: 160px;">
                        <span class="handwritten-value">@_testimonial.PostOffice</span>
                    </div>
                    <span>Upzilla </span> 
                    <div class="field-dot-line" style="width: 160px;">
                        <span class="handwritten-value">@_testimonial.Upazila</span>
                    </div>
                </div>
                <div>
                    <span>Distric </span> 
                    <div class="field-dot-line" style="width: 140px;">
                        <span class="handwritten-value">@_testimonial.District</span>
                    </div>
                    <span>He is a irregular student and has obtained G.P.A </span> 
                    <div class="field-dot-line" style="width: 80px;">
                        <span class="handwritten-value" style="font-family: 'EB Garamond', serif; font-size: 1.15rem;">@_testimonial.GPA</span>
                    </div>
                </div>
                <div>
                    <span>Group </span> 
                    <div class="field-dot-line" style="width: 220px;">
                        <span class="handwritten-value">@_testimonial.Group</span>
                    </div>
                    <span>in the Secondary Certificate Examination</span>
                </div>
                <div>
                    <span>in the year </span> 
                    <div class="field-dot-line" style="width: 120px;">
                        <span class="handwritten-value" style="font-family: 'EB Garamond', serif;">@_testimonial.ExamYear</span>
                    </div>
                    <span>under the Secondary and Higher, Secondary</span>
                </div>
                <div>
                    <span>Examination Board. He owns Roll </span> 
                    <div class="field-dot-line" style="width: 210px;">
                        <span class="handwritten-value">@_testimonial.Roll</span>
                    </div>
                    <span>No </span> 
                    <div class="field-dot-line" style="width: 210px;">
