                    <div class="wish-text" style="margin-top: 10px; text-align: left; font-weight: 400;">I wish him every success in future</div>
                </div>
            </div>

            <!-- Signature Section -->
            <div class="signature-section">
                <div class="writer-side">
                    <div class="sig-hand">Akhtar</div>
                    <p>Writer <span></span></p>
                    <p style="margin-top: 10px;">Date <span></span></p>
                </div>

                <div class="headmaster-side">
                    <div class="sig-bangla">মকবুল হোসেন</div>
                    <div class="stamp-box">
                        <span class="stamp-role">Asst. Headmaster</span>
                        <div class="stamp-school">
