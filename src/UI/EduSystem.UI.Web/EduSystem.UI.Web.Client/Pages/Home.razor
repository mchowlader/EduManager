@* @page "/"
@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveAuto

<PageTitle>Dashboard</PageTitle>

<div class="row">
    <!-- Top Stats Row (Preserved) -->
    <div class="col-12 col-md-6 col-lg-3 mb-4">
        <div class="glass-stat-card">
            <div class="stat-icon-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.People" />
            </div>
            <div class="stat-content">
                <span class="stat-value">1,250</span>
                <span class="stat-label">Total Students</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3 mb-4">
        <div class="glass-stat-card">
            <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #0ba360 0%, #3cba92 100%); box-shadow: 0 4px 10px rgba(60, 186, 146, 0.3);">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </div>
            <div class="stat-content">
                <span class="stat-value">50</span>
                <span class="stat-label">Total Teachers</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3 mb-4">
        <div class="glass-stat-card">
            <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #ffc107 0%, #f7b42c 100%); box-shadow: 0 4px 10px rgba(247, 180, 44, 0.3);">
                <MudIcon Icon="@Icons.Material.Filled.Class" />
            </div>
            <div class="stat-content">
                <span class="stat-value">25</span>
                <span class="stat-label">Total Classes</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3 mb-4">
        <div class="glass-stat-card">
            <div class="stat-icon-wrapper" style="background: linear-gradient(135deg, #2196f3 0%, #21cbf3 100%); box-shadow: 0 4px 10px rgba(33, 203, 243, 0.3);">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
            </div>
            <div class="stat-content">
                <span class="stat-value">95%</span>
                <span class="stat-label">Attendance Rate</span>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Attendance Chart -->
    <div class="col-12 col-lg-8 mb-4">
        <div class="glass-panel">
            <div class="widget-header">
                <span class="widget-title">Attendance Overview</span>
                <span class="widget-action">View Report</span>
            </div>
            <MudChart ChartType="ChartType.Line" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="300px" ChartOptions="@chartOptions"></MudChart>
        </div>
    </div>
    
    <!-- Student Ratio Donut -->
    <div class="col-12 col-lg-4 mb-4">
        <div class="glass-panel d-flex flex-column align-center justify-center">
            <div class="widget-header w-100">
                <span class="widget-title">Student Ratio</span>
            </div>
            <MudChart ChartType="ChartType.Donut" Width="100%" Height="250px" InputData="@data" InputLabels="@labels">
                <CustomGraphics>
                    <text class="donut-inner-text" x="50%" y="40%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="2">Total</text>
                    <text class="donut-inner-text" x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="5" font-weight="bold">1,250</text>
                </CustomGraphics>
            </MudChart>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Financial Overview -->
    <div class="col-12 col-md-6 mb-4">
        <div class="glass-panel">
            <div class="widget-header">
                <span class="widget-title">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Primary" /> 
                    Financial Overview
                </span>
                <span class="widget-action">Detailed Report</span>
            </div>
            
            <div class="row g-3">
                <div class="col-6">
                    <div class="vis-card">
                        <div class="d-flex justify-content-between align-items-start">
                             <div class="vis-label">Today's Collection</div>
                             <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Success" Size="Size.Small" />
                        </div>
                        <div class="vis-value mt-2">৳ 50k</div>
                        <div class="trend-up mt-1" style="font-size: 0.75rem;">+12% vs avg</div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="vis-card">
                         <div class="d-flex justify-content-between align-items-start">
                             <div class="vis-label">Pending Dues</div>
                             <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                        </div>
                        <div class="vis-value mt-2 text-danger">৳ 200k</div>
                        <div class="trend-down mt-1" style="font-size: 0.75rem;">Requires Action</div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <div class="d-flex justify-content-between mb-1">
                    <span class="vis-label">Monthly Target</span>
                    <span class="font-weight-bold" style="color: #4a5568">60%</span>
                </div>
                <MudProgressLinear Color="Color.Success" Value="60" Rounded="true" Size="Size.Large" Striped="true" />
            </div>
        </div>
    </div>

    <!-- Upcoming Events (Card System) -->
    <div class="col-12 col-md-6 mb-4">
        <div class="glass-panel">
            <div class="widget-header">
                <span class="widget-title">
                     <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Secondary" />
                     Upcoming Events
                </span>
                <span class="widget-action">Calendar</span>
            </div>
            <div class="mt-3">
                <div class="event-card">
                    <div class="event-date-mini">
                        <div class="event-date-day">12</div>
                        <div class="event-date-month">JAN</div>
                    </div>
                    <div class="list-content">
                        <div class="list-title">Math Final Exam</div>
                        <div class="list-subtitle">Main Hall • 10:00 AM</div>
                    </div>
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="ml-2">Exam</MudChip>
                </div>
                
                <div class="event-card" style="border-left-color: #38a169;">
                    <div class="event-date-mini">
                        <div class="event-date-day">20</div>
                        <div class="event-date-month">DEC</div>
                    </div>
                    <div class="list-content">
                        <div class="list-title">Winter Vacation</div>
                        <div class="list-subtitle">School Closed (10 Days)</div>
                    </div>
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="ml-2">Holiday</MudChip>
                </div>

                 <div class="event-card" style="border-left-color: #3182ce;">
                    <div class="event-date-mini">
                        <div class="event-date-day">05</div>
                        <div class="event-date-month">FEB</div>
                    </div>
                    <div class="list-content">
                        <div class="list-title">Parent's Meeting</div>
                        <div class="list-subtitle">Auditorium</div>
                    </div>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Class="ml-2">Meeting</MudChip>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <!-- Top Students (Card System) -->
     <div class="col-12 col-xl-7 mb-4">
        <div class="glass-panel">
            <div class="widget-header">
                <span class="widget-title">
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
                    Top Performers (Term 1)
                </span>
            </div>
            <div class="row mt-2">
                 <!-- Rank 1 Card -->
                 <div class="col-12 col-sm-4">
                     <div class="student-card">
                         <div class="rank-measure">🥇 1st</div>
                         <MudAvatar Color="Color.Primary" Style="height:60px; width:60px; font-size:1.5rem;" Class="mb-2">R</MudAvatar>
                         <div class="student-info">
                             <div class="student-name">Rahim Uddin</div>
                             <div class="student-class">Class 10 (Science)</div>
                             <div class="student-gpa">GPA 5.00</div>
                         </div>
                     </div>
                 </div>

                 <!-- Rank 2 Card -->
                 <div class="col-12 col-sm-4">
                     <div class="student-card">
                         <div class="rank-measure" style="color: #718096;">🥈 2nd</div>
                         <MudAvatar Color="Color.Secondary" Style="height:60px; width:60px; font-size:1.5rem;" Class="mb-2">K</MudAvatar>
                         <div class="student-info">
                             <div class="student-name">Karim Ahmed</div>
                             <div class="student-class">Class 10 (Science)</div>
                             <div class="student-gpa">GPA 4.90</div>
                         </div>
                     </div>
                 </div>

                 <!-- Rank 3 Card -->
                 <div class="col-12 col-sm-4">
                     <div class="student-card">
                         <div class="rank-measure" style="color: #B7791F;">🥉 3rd</div>
                         <MudAvatar Color="Color.Success" Style="height:60px; width:60px; font-size:1.5rem;" Class="mb-2">S</MudAvatar>
                         <div class="student-info">
                             <div class="student-name">Sadia Afrin</div>
                             <div class="student-class">Class 10 (Commerce)</div>
                             <div class="student-gpa">GPA 4.88</div>
                         </div>
                     </div>
                 </div>
            </div>
        </div>
     </div>
     
     <!-- Status & Notices -->
      <div class="col-12 col-xl-5 mb-4">
        <div class="glass-panel">
            <div class="widget-header">
                <span class="widget-title">
                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Info" />
                    Daily Status
                </span>
            </div>
            
            <div class="mb-3">
                <div class="row">
                    <div class="col-6">
                        <div class="leave-card">
                             <MudAvatar Image="https://mudblazor.com/images/users/1.jpg" Size="Size.Medium" />
                             <div class="leave-info">
                                 <div class="leave-name">Nasrin Akter</div>
                                 <div class="leave-type">Sick Leave</div>
                             </div>
                        </div>
                    </div>
                     <div class="col-6">
                        <div class="leave-card">
                             <MudAvatar Color="Color.Info" Size="Size.Medium">J</MudAvatar>
                             <div class="leave-info">
                                 <div class="leave-name">Jamal Hossain</div>
                                 <div class="leave-type" style="color: orange; background: #fffaf0;">Casual</div>
                             </div>
                        </div>
                    </div>
                </div>
            </div>
             
             <div class="notice-card mt-auto">
                 <div class="d-flex align-center gap-2 mb-1">
                     <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" />
                     <strong>Warning: Heavy Rain</strong>
                 </div>
                 <p class="m-0" style="font-size: 0.9rem; line-height: 1.4;">School will remain closed tomorrow (13 Jan) due to heavy rainfall forecast.</p>
             </div>
        </div>
     </div>
</div>

@code {
    // Chart Data
    public List<ChartSeries> Series = new List<ChartSeries>()
    {
        new ChartSeries() { Name = "Attendance", Data = new double[] { 90, 85, 92, 95, 94, 98, 96, 95, 99 } }
    };
    public string[] XAxisLabels = { "Jan 1", "Jan 2", "Jan 3", "Jan 4", "Jan 5", "Jan 6", "Jan 7", "Jan 8", "Jan 9" };

    public ChartOptions chartOptions = new ChartOptions(){
        ChartPalette = new string[] { "#667eea" }
    };

    // Donut Data
    public double[] data = { 750, 500 }; // Boys, Girls
    public string[] labels = { "Boys (60%)", "Girls (40%)" };
} *@
@page "/"
@using EduSystem.UI.Web.Client.Models.AuthClient
@using EduSystem.UI.Web.Client.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using EduSystem.UI.Web.Client.Services
@using Microsoft.JSInterop
@rendermode InteractiveAuto
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProviderBase

<PageTitle>EduSystem - Education Management</PageTitle>

<!-- Visitor Portal Header (Visible only to Guests) -->
<AuthorizeView>
    <NotAuthorized>
        <!-- Premium Image Slider for Visitors -->
        <div class="visitor-banner-container mb-8">
            <MudCarousel Class="mud-width-full banner-slider" 
                         Style="height:450px; border-radius: 24px;" 
                         ShowArrows="true" 
                         ShowBullets="true" 
                         AutoCycle="true" 
                         TData="string">
                <MudCarouselItem Transition="Transition.Fade">
                    <div class="banner-slide">
                        <img src="/images/banner/campus.png" alt="Campus" class="banner-img" />
                        <div class="banner-overlay">
                            <MudText Typo="Typo.h3" Class="banner-title">Empowering the Future of Education</MudText>
                            <MudText Typo="Typo.h6" Class="banner-subtitle mb-6">Experience the next generation of campus management.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/admission"))" StartIcon="@Icons.Material.Filled.School" Size="Size.Large" Style="border-radius: 12px; font-weight: 700; padding: 10px 24px;">Online Admission</MudButton>
                        </div>
                    </div>
                </MudCarouselItem>
                <MudCarouselItem Transition="Transition.Fade">
                    <div class="banner-slide">
                        <img src="/images/banner/classroom.png" alt="Classroom" class="banner-img" />
                        <div class="banner-overlay">
                            <MudText Typo="Typo.h3" Class="banner-title">Smart Learning Environments</MudText>
                            <MudText Typo="Typo.h6" Class="banner-subtitle">Modern tools for modern students and educators.</MudText>
                        </div>
                    </div>
                </MudCarouselItem>
                <MudCarouselItem Transition="Transition.Fade">
                    <div class="banner-slide">
                        <img src="/images/banner/graduation.png" alt="Graduation" class="banner-img" />
                        <div class="banner-overlay">
                            <MudText Typo="Typo.h3" Class="banner-title">Celebrate Every Milestone</MudText>
                            <MudText Typo="Typo.h6" Class="banner-subtitle">From first day to graduation, we're with you.</MudText>
                        </div>
                    </div>
                </MudCarouselItem>
            </MudCarousel>
        </div>
    </NotAuthorized>
    <Authorized>
        <div class="member-welcome-bar mb-6 pa-6">
             <MudText Typo="Typo.h4" Style="font-weight: 900; color: #1e293b;">
                Welcome Back, @(_userInfo?.FullName ?? "Member")! 👋
            </MudText>
        </div>
    </Authorized>
</AuthorizeView>

