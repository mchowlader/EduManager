<style>
    .glass-stat-card {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        display: flex;
        align-items: center;
        gap: 1.25rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border-bottom: 4px solid #5E35B1;
    }

    .stat-icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        display: block;
        color: #1e293b;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 500;
    }

    .glass-panel {
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.5);
        height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }

    .widget-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .widget-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
    }

    .vis-card {
        padding: 1rem;
        background: white;
        border-radius: 12px;
        border: 1px solid #edf2f7;
    }

    .vis-label {
        font-size: 0.75rem;
        color: #718096;
        font-weight: 600;
    }

    .vis-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2d3748;
    }

    .event-card {
        display: flex;
        align-items: center;
        padding: 1rem;
        background: white;
        border-radius: 12px;
        margin-bottom: 0.75rem;
        border-left: 4px solid #ef4444;
    }

    .event-date-mini {
        text-align: center;
        padding-right: 1rem;
        border-right: 1px solid #edf2f7;
        margin-right: 1rem;
        min-width: 50px;
    }

    .event-date-day {
        font-size: 1.25rem;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
