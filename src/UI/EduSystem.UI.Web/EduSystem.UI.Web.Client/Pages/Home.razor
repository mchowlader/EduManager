@code {
    private UserInfo? _userInfo;
    private TenantInfo? _tenantInfo;
    private bool _isLoading = true;

    // Chart Data
    public List<ChartSeries> Series = new List<ChartSeries>()
    {
        new ChartSeries() { Name = "Attendance", Data = new double[] { 90, 85, 92, 95, 94, 98, 96, 95, 99 } }
    };
    public string[] XAxisLabels = { "Jan 1", "Jan 2", "Jan 3", "Jan 4", "Jan 5", "Jan 6", "Jan 7", "Jan 8", "Jan 9" };

    public ChartOptions chartOptions = new ChartOptions(){
        ChartPalette = new string[] { "#1976d2" }
    };

    // Donut Data
    public double[] data = { 750, 500 }; 
    public string[] labels = { "Boys (60%)", "Girls (40%)" };

    [SupplyParameterFromQuery(Name = "auth")]
    public string? AuthData { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthStateProviderBase.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                if (!string.IsNullOrEmpty(AuthData))
                {
                    var authJson = Uri.UnescapeDataString(AuthData);
                    var loginResponse = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(authJson);

                    if (loginResponse != null)
                    {
                        await AuthStateProvider.MarkUserAsAuthenticated(loginResponse);
                        Navigation.NavigateTo("/", replace: true);
                        return;
                    }
                }

                await LoadUserData();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading auth data: {ex.Message}");
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadUserData()
    {
        try
        {
            _userInfo = await AuthStateProvider.GetUserInfoAsync();
            _tenantInfo = await AuthStateProvider.GetTenantInfoAsync();

            var authState = await AuthStateProviderBase.GetAuthenticationStateAsync();
            if (!authState.User.Identity?.IsAuthenticated ?? true)
            {
                _userInfo = null;
                _tenantInfo = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user data: {ex.Message}");
            _userInfo = null;
            _tenantInfo = null;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        await LoadUserData();
    }

    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProviderBase.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
