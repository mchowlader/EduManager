@page "/access-denied"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Access Denied - EduSystem</PageTitle>

<div class="access-denied-wrapper">
    <div class="glass-error-card">
        <div class="illustration-container mb-6">
            <div class="lock-circle">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 4rem;" />
            </div>
            <div class="pulse-ring"></div>
        </div>

        <MudText Typo="Typo.h3" Class="error-title mb-2">403</MudText>
        <MudText Typo="Typo.h5" Class="error-subtitle mb-4">You don't have permission to access this page</MudText>
        
        <div class="divider-glow mb-6"></div>
        
        <MudText Typo="Typo.body1" Class="error-description mb-8">
            Please contact your administrator if you believe this is a mistake or try logging in with a different account.
        </MudText>

        <MudStack Row="true" Spacing="4" Justify="Justify.Center" Class="mb-4">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       OnClick="@(() => Navigation.NavigateTo("/"))"
                       StartIcon="@Icons.Material.Filled.Home"
                       Class="action-button primary-glow">
                Back to Home
            </MudButton>
            
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       OnClick="@(() => Navigation.NavigateTo("/login"))"
                       StartIcon="@Icons.Material.Filled.Login"
                       Class="action-button outline-box">
                Login Again
            </MudButton>
        </MudStack>
        
        <MudLink OnClick="@(() => Navigation.NavigateTo("/contact-support"))" Color="Color.Secondary" Underline="Underline.Hover">
            Contact Support
        </MudLink>
    </div>
</div>

<style>
    .access-denied-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at top right, #f8fafc 0%, #e2e8f0 100%);
        padding: 2rem;
    }

    .glass-error-card {
        max-width: 600px;
        width: 100%;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 40px;
        padding: 4rem 3rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
        text-align: center;
        animation: fadeInScale 0.6s ease-out;
    }

    .illustration-container {
        position: relative;
        display: inline-block;
    }

    .lock-circle {
        width: 120px;
        height: 120px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 25px rgba(239, 68, 68, 0.15);
        z-index: 2;
        position: relative;
    }

    .pulse-ring {
        position: absolute;
        top: -10px;
        left: -10px;
        right: -10px;
        bottom: -10px;
        border-radius: 50%;
        border: 2px solid rgba(239, 68, 68, 0.2);
        animation: pulse 2s infinite;
    }

    .error-title {
        font-weight: 900;
        color: #ef4444;
        letter-spacing: -2px;
        text-shadow: 0 2px 10px rgba(239, 68, 68, 0.1);
    }

    .error-subtitle {
        font-weight: 700;
        color: #1e293b;
    }

    .divider-glow {
        height: 2px;
        width: 80px;
        background: linear-gradient(90deg, transparent, #ef4444, transparent);
        margin: 0 auto;
    }

    .error-description {
        color: #64748b;
        line-height: 1.6;
        font-size: 1.1rem;
    }

    .english-subtitle {
        font-size: 0.9rem;
        font-style: italic;
        opacity: 0.8;
    }

    .action-button {
        border-radius: 16px !important;
        text-transform: none !important;
        font-weight: 700 !important;
        padding: 0.8rem 1.5rem !important;
    }

    .primary-glow {
        box-shadow: 0 10px 15px -3px rgba(var(--mud-palette-primary-rgb), 0.3);
        transition: all 0.3s ease;
    }

    .primary-glow:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 25px -5px rgba(var(--mud-palette-primary-rgb), 0.4);
    }

    .outline-box {
        border-width: 2px !important;
    }

    @@keyframes pulse {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(1.3); opacity: 0; }
    }

    @@keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
</style>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
}
