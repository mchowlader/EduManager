@using Microsoft.AspNetCore.Components.Authorization
@using EduSystem.UI.Web.Client.Pages

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData">
                <NotAuthorized>
                    <RedirectToAccessDenied />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    private class RedirectToLogin : ComponentBase
    {
        [Inject] NavigationManager Navigation { get; set; } = default!;
        protected override void OnInitialized() => Navigation.NavigateTo("/login", true);
    }

    private class RedirectToAccessDenied : ComponentBase
    {
        [Inject] NavigationManager Navigation { get; set; } = default!;
        protected override void OnInitialized() => Navigation.NavigateTo("/access-denied", true);
    }
}