@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" 
                   Style="@($"position: fixed; top: 10px; left: {(_drawerOpen ? "270px" : "70px")}; z-index: 2000; color: #4a5568 !important; transition: left 0.3s ease-in-out;")" />

    <MudAppBar Elevation="0" Class="top-bar-glass" Fixed="true">
        <MudText Typo="Typo.h6" Class="d-none d-md-block" style="font-weight: 600; color: #4a5568; margin-left: 50px;">Dashboard</MudText>
        <MudSpacer />
        
        <!-- User Profile Section -->
        <div class="user-profile-section">
            <div class="d-flex flex-column align-end mr-2 d-none d-sm-flex">
                <span class="user-name">Admin User</span>
                <span class="user-role">Administrator</span>
            </div>
            <div class="user-avatar">AD</div>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" 
               Elevation="1" 
               Variant="@DrawerVariant.Mini" 
               OpenMiniOnHover="true"
               ClipMode="DrawerClipMode.Never" 
               Class="mud-drawer-gradient">
        <MudDrawerHeader Class="d-flex align-center gap-2 px-3">
             @if (_drawerOpen)
             {
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" Size="Size.Large" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: white; white-space:nowrap;">
                    EduSystem
                </MudText>
             }
             else 
             {
                 <!-- Show icon in mini mode centered if desired, or hide everything to keep stripped look clean -->
                 <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Inherit" Size="Size.Large" Class="mx-auto" />
             }
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
